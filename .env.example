# Neon PostgreSQL Database URL
# Obtén tu connection string desde https://console.neon.tech
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Configuración de Moneda y Localización
NEXT_PUBLIC_CURRENCY_SYMBOL="Bs"
NEXT_PUBLIC_CURRENCY_NAME="Bolivianos"

# Clave secreta para firma de sesiones (HMAC-SHA256, mínimo 32 bytes / 64 caracteres hex)
# Generar en consola con: openssl rand -hex 32
SESSION_SECRET="tu_clave_secreta_de_al_menos_32_bytes_aqui_generada_aleatoriamente"

# Cuentas de demostración en /portal para pruebas rápidas (1 = activado en desarrollo/preview)
ENABLE_DEMO_LOGIN=1

# Clave independiente opcional para PIN de supervisor (si se omite, hereda SESSION_SECRET)
# SUPERVISOR_PIN_SECRET=""
